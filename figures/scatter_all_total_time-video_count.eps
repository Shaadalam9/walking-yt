8 dict begin
/FontType 3 def
/FontMatrix [0.00125 0 0 -0.00125 0 0] def
/FontBBox [-1 101 802 -702] def
/Encoding 256 array def
  0 1 255 { Encoding exch /.notdef put } for
/BuildGlyph {
  exch /CharProcs get exch
  2 copy known not { pop /.notdef } if
  get exec
