  "WALK_GEOCODE_CACHE": "walking_geocode_cache.json",
  "HF_HOME": null,
  "HF_HUB_CACHE": null,
  "HF_XET_HIGH_PERFORMANCE": true,
  "TOKENIZERS_PARALLELISM": false,
  "PYTORCH_CUDA_ALLOC_CONF": null,
  "WALKING_QUERIES": [
    "walking tour",
    "city walk",
    "walk with me",
    "virtual walk",
    "4k walking tour",
    "POV walking",
    "street walk",
    "nature walk",
    "rain walk",
    "night walk"
  ],
  "MAX_PAGES_PER_QUERY": 2,
  "RESULTS_PER_PAGE": 50,
  "MAX_NEW_CANDIDATES": 200,
  "MAX_VIDEOS_PER_RUN": 200,
  "CONTINUOUS_BATCH_MODE": true,
  "CONTINUOUS_BATCH_PAUSE_SECONDS": 5,
  "CONTINUOUS_IDLE_PAUSE_SECONDS": 900,
  "VIDEO_DOWNLOAD_QUEUE_SIZE": 5,
  "VIDEO_DOWNLOAD_FAILURE_ALLOWANCE_PER_RUN": 5,
  "VIDEO_DOWNLOAD_MAX_CONSECUTIVE_FAILURES": 3,
  "VIDEO_DOWNLOAD_STOP_ON_AUTH_ERROR": true,
  "DELETE_VIDEO_AFTER_PROCESSING": false,
  "MIN_VIDEO_DURATION_SECONDS": 300,
  "PUBLISHED_AFTER": null,
  "PUBLISHED_BEFORE": null,
  "TEXT_LLM_MODEL": "Qwen/Qwen3-4B-Instruct-2507",
  "TEXT_LLM_4BIT": false,
  "TEXT_MAX_NEW_TOKENS": 384,
  "MIN_TEXT_CONFIDENCE": 0.6,
  "VISUAL_MODEL_BACKEND": "cosmos3",
  "INTERNVL_MODEL": "OpenGVLab/InternVL3_5-14B-HF",
  "INTERNVL_4BIT": false,
  "FRAMES_PER_SAMPLE": 6,
  "VLM_MAX_NEW_TOKENS": 320,
  "COSMOS3_MODEL": "nvidia/Cosmos3-Nano",
  "COSMOS3_4BIT": false,
  "COSMOS3_MAX_NEW_TOKENS": 256,
  "COSMOS3_BATCH_SIZE": 1,
  "CLIP_PREPARE_WORKERS": 2,
  "COSMOS3_FAST_MODE": false,
  "COSMOS3_INTRO_SEARCH_SECONDS": 90,
  "COSMOS3_INTRO_FPS": 1.0,
  "COSMOS3_MIN_CONTENT_START_CONFIDENCE": 0.6,
  "COSMOS3_FRAMES_PER_SAMPLE": 12,
  "COSMOS3_REVIEW_FPS": 2.0,
  "COSMOS3_LONG_WINDOW_SECONDS": 120,
  "COSMOS3_LONG_WINDOW_BURSTS": 4,
  "COSMOS3_LONG_WINDOW_SOURCE_FPS": 1.0,
  "COSMOS3_CUT_FPS": 8.0,
  "COSMOS3_VIDEO_WIDTH": 384,
  "COSMOS3_MIN_WALKING_FRACTION": 0.33,
  "COSMOS3_MAX_PROMOTION_FRACTION": 0.4,
  "MIN_SEGMENT_DURATION_SECONDS": 15,
  "MAX_SEGMENT_REVIEW_SECONDS": 240,
  "MIN_CUT_CONFIDENCE": 0.7,
  "MIN_SEGMENT_CONFIDENCE": 0.7,
  "CUT_VERIFICATION_SECONDS": 2,
  "PIPELINE_MODE": "auto",
  "SEQUENTIAL_DEVICE": "cuda:0",
  "TEXT_DEVICE": "cuda:0",
  "VLM_DEVICE": "cuda:1",
  "TEXT_MAX_OUTSTANDING": 16,
  "VISUAL_MAX_OUTSTANDING": 2,
  "WORKER_POLL_SECONDS": 0.1,
  "WORKER_START_TIMEOUT_SECONDS": 1800,
  "WALK_VIDEO_FORMAT": "bv*[height=720]+ba/b[height=720]/bv*[height=480]+ba/b[height=480]/bv*[height=360]+ba/b[height=360]/bv*[height=144]+ba/b[height=144]/bv*[height<=720]+ba/b[height<=720]/bv*+ba/b",
  "YT_DLP_COOKIE_FILE": "cookies.txt",
  "YT_DLP_COOKIES_FROM_BROWSER": null,
