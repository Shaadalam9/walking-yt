  "YT_DLP_FILE_ACCESS_RETRIES": 10,
  "YT_DLP_DOWNLOAD_ATTEMPTS": 1,
  "YT_DLP_RETRY_SLEEP": "exp=1:5",
  "YT_DLP_FRAGMENT_RETRY_SLEEP": "exp=1:5",
  "YT_DLP_HTTP_CHUNK_SIZE": "10M",
  "YT_DLP_SOCKET_TIMEOUT_SECONDS": 30,
  "YT_DLP_DOWNLOAD_TIMEOUT_SECONDS": 7200,
  "SCENE_THRESHOLD": 0.45,
  "SCDET_THRESHOLD": 8.0,
  "CUT_DETECTION_BACKEND": "auto",
  "CUT_DETECTION_FPS": 6.0,
  "CUT_DETECTION_WIDTH": 320,
  "CUT_DETECTION_CPU_FALLBACK": true,
  "MERGE_NEARBY_SEC": 2.0,
  "IGNORE_FIRST_SEC": 0.0,
  "IGNORE_LAST_SEC": 0.0,
  "CUT_DETECTION_TIMEOUT": 7200,
  "ENABLE_GEOCODING": true,
  "GEOCODER_USER_AGENT": "walking-video-research-pipeline/1.0",
  "GEOCODER_DELAY_SECONDS": 1.1
}
