{
  "data": "/Volumes/Alam/pedestrians_in-youtube/data/bbox",
  "mapping": "mapping.csv",
  "output_dir": "_output",
  "VIDEO_BASE_URL": "https://files.mobility-squad.com/",
  "videos": "videos",
  "SPIKE1_MODE": false,
  "SPIKE1_REQUIRE_GPU": false,
  "SPIKE1_REQUIRE_PERSISTENT_STORAGE": false,
  "WALK_DATA_DIR": "data",
  "WALK_STATE_JSON": "walking_pipeline_state.json",
  "WALK_OUTPUT_CSV": "walking_segments.csv",
  "WALK_VIDEO_DIR": "walking_videos",
